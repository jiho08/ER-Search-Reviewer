# Copy to .env for local development. Never commit a real key.
# Official developer portal: https://developer.eternalreturn.io/
ER_API_KEY=
# Local Codex uses your ChatGPT login. Run npm run setup:codex once.
AI_PROVIDER=codex
CODEX_BRIDGE_URL=http://127.0.0.1:4318
# Generated locally by setup:codex; never put ChatGPT login tokens here.
CODEX_BRIDGE_TOKEN=
# Optional Codex model override; blank uses the Codex default.
CODEX_MODEL=
# Optional alternative: set AI_PROVIDER=openai for API billing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
