{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lumia-er-reviewer",
  "main": "../workers/app.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "APP_MODE": "public",
    "AI_PROVIDER": "rules",
    "AI_DAILY_LIMIT": "0",
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "durable_objects": {
    "bindings": [{ "name": "LUMIA_STATE", "class_name": "LumiaState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LumiaState"] }],
  "observability": { "enabled": false }
}
